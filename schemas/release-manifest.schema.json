{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/shynloc/workbuddy-open-platform-devkit/schemas/release-manifest.schema.json",
  "title":"WB-OPDK Release Manifest",
  "type":"object",
  "required":["schema_version","asset","generated_at","source","files","validation"],
  "properties":{
    "schema_version":{"const":1},
    "asset":{
      "type":"object",
      "required":["type","name","version"],
      "properties":{
        "type":{"enum":["skill","expert","expert-team","connector","buddy-app","third-party-app"]},
        "name":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1}
      },
      "additionalProperties":true
    },
    "generated_at":{"type":"string"},
    "source":{
      "type":"object",
      "required":["path"],
      "properties":{
        "path":{"type":"string"},
        "git_commit":{"type":["string","null"]},
        "official_registry_reviewed_at":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "files":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["path","sha256","bytes"],
        "properties":{
          "path":{"type":"string"},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "bytes":{"type":"integer","minimum":0}
        }
      }
    },
    "validation":{
      "type":"object",
      "required":["status"],
      "properties":{
        "status":{"enum":["pass","fail","not-run"]},
        "validator":{"type":["string","null"]},
        "notes":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":true
    },
    "security":{
      "type":"object",
      "properties":{
        "secret_scan":{"enum":["pass","fail","not-run"]},
        "side_effect_review":{"enum":["pass","fail","not-applicable","not-run"]}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
