{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shynloc/workbuddy-open-platform-devkit/schemas/connector-meta.schema.json",
  "title": "WB-OPDK connector-meta.json",
  "description": "Derived schema for WorkBuddy Connector metadata. Version-gated semantics are additionally checked by scripts/validate_connector.py.",
  "type":"object",
  "required":["name","name_en","description","description_zh","description_en","source"],
  "properties":{
    "name":{"type":"string","minLength":1},
    "name_zh":{"type":"string"},
    "name_en":{"type":"string","minLength":1},
    "description":{"type":"string","minLength":1},
    "description_zh":{"type":"string","minLength":1},
    "description_en":{"type":"string","minLength":1},
    "source":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "type":{"enum":["mcp","cli","skill-only"]},
    "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"},
    "examples_zh":{"type":"array","minItems":2,"maxItems":5,"items":{"type":"string"}},
    "examples_en":{"type":"array","minItems":2,"maxItems":5,"items":{"type":"string"}},
    "auth_mode":{"enum":["server-side","gateway","token"]},
    "minWorkbuddyVersion":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "maxWorkbuddyVersion":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "name_map":{"type":"object","additionalProperties":{"type":"string"}},
    "description_map":{"type":"object","additionalProperties":{"type":"string"}}
  },
  "additionalProperties":true
}
