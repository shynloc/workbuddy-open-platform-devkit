{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/shynloc/workbuddy-open-platform-devkit/schemas/token-schema.schema.json",
  "title":"WB-OPDK token-schema.json",
  "type":"object",
  "required":["title","description","fields"],
  "properties":{
    "title":{"type":"string","minLength":1},
    "title_en":{"type":"string"},
    "description":{"type":"string","minLength":1},
    "description_en":{"type":"string"},
    "docUrl":{"type":"string"},
    "docLabel":{"type":"string"},
    "docLabel_en":{"type":"string"},
    "fields":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["key","label","type","required"],
        "properties":{
          "key":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"},
          "label":{"type":"string","minLength":1},
          "label_en":{"type":"string"},
          "type":{"enum":["text","password"]},
          "required":{"type":"boolean"},
          "placeholder":{"type":"string"},
          "defaultValue":{"type":"string"},
          "description":{"type":"string"},
          "description_en":{"type":"string"}
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":true
}
