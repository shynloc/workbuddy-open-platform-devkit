{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shynloc/workbuddy-open-platform-devkit/schemas/agent-frontmatter.schema.json",
  "title": "WB-OPDK Expert Agent Markdown Frontmatter",
  "description": "DERIVED schema for parsed WorkBuddy Expert/Expert Team agent Markdown frontmatter.",
  "type": "object",
  "required": ["name", "description", "displayName", "profession"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "$ref": "#/$defs/localized"
    },
    "profession": {
      "$ref": "#/$defs/localized"
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "localized": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "properties": {
            "zh": {"type": "string", "minLength": 1},
            "en": {"type": "string", "minLength": 1}
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": true
}
