{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shynloc/workbuddy-open-platform-devkit/schemas/validation-record.schema.json",
  "title": "WB-OPDK Real-world Validation Record",
  "description": "DERIVED schema for recording observed WorkBuddy parser/runtime/review evidence.",
  "type": "object",
  "required": ["schema_version", "asset", "environment", "stages", "evidence", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "asset": {
      "type": "object",
      "required": ["type", "name", "version"],
      "properties": {
        "type": {"enum": ["skill", "expert", "expert-team", "connector", "buddy-app", "third-party-app"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": ["observed_at"],
      "properties": {
        "observed_at": {"type": "string"},
        "workbuddy_version": {"type": ["string", "null"]},
        "platform": {"type": ["string", "null"]},
        "publisher_type": {"enum": ["personal", "enterprise", "unknown"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "object",
      "properties": {
        "local_validation": {"$ref": "#/$defs/stage"},
        "platform_parse": {"$ref": "#/$defs/stage"},
        "runtime_test": {"$ref": "#/$defs/stage"},
        "platform_review": {"$ref": "#/$defs/stage"},
        "published": {"$ref": "#/$defs/stage"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": {"enum": ["screenshot", "url", "log", "artifact", "review-message", "manual-note"]},
          "description": {"type": "string", "minLength": 1},
          "ref": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["knowledge_type", "summary"],
        "properties": {
          "knowledge_type": {"enum": ["OBSERVED", "EXPERIMENTAL"]},
          "summary": {"type": "string", "minLength": 1},
          "affects": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "status": {
      "enum": [
        "candidate",
        "platform-parse-passed",
        "runtime-passed",
        "reviewing",
        "review-rejected",
        "review-approved",
        "published",
        "retired"
      ]
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not-run", "pass", "fail", "pending", "not-applicable"]},
        "at": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
